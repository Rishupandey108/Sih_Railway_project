# ==============================================================================
# Indian Railways Maintenance AI System — Git Ignore Configuration
# ==============================================================================

# ── Secrets & Environment Configurations ──────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Synthetic Data & Generated Output Files ───────────────────────────────────
# data/*.csv
# data/*.json
!data/.gitkeep

# ── Trained Model Artifacts (.pkl, .joblib, etc.) ─────────────────────────────
# models/*.pkl
# models/*.joblib
!models/.gitkeep


# ── Reports & Generated Visualizations ────────────────────────────────────────
reports/*.png
reports/*.jpg
reports/*.pdf
reports/*.html
!reports/.gitkeep

# ── Python Cache & Bytecode ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp

# ── IDEs & Operating System Files ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
