# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application settings
APP_ENV=development         # development | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
